  "grammar": {
    "topic": "relative",
    "topicZh": "關係代名詞",
    "tip": "先看空格前面的名詞：是「人」用 who；是「物」用 which；人或物都可以用 that；表示「誰的」用 whose。再看空格後面缺不缺主詞，缺就用關係代名詞。",
    "items": [
      {
        "q": "The auditor _____ visited us last week was very kind.",
        "opts": [
          "which",
          "who",
          "whose",
          "what"
        ],
        "answer": 1,
        "why": "先行詞 auditor 是人，後面缺主詞，用 who。which 用在物，what 不能當關係代名詞連接前面的名詞。",
        "zh": "上週來訪的稽核員人很親切。"
      },
      {
        "q": "This is the report _____ shows the test results.",
        "opts": [
          "who",
          "whose",
          "which",
          "where"
        ],
        "answer": 2,
        "why": "先行詞 report 是物，後面缺主詞，用 which（或 that）。who 是人，where 是地點。",
        "zh": "這就是顯示測試結果的報告。"
      },
      {
        "q": "The customer _____ order was late is calling now.",
        "opts": [
          "who",
          "whose",
          "which",
          "whom"
        ],
        "answer": 1,
        "why": "customer 和 order 是「所有關係」（客戶的訂單），用 whose。",
        "zh": "訂單延遲的那位客戶現在正在打電話來。"
      },
      {
        "q": "We need a supplier _____ can deliver on time.",
        "opts": [
          "who",
          "which",
          "whose",
          "what"
        ],
        "answer": 0,
        "why": "supplier 指的是人或公司，後面缺主詞，用 who（that 也可以）。which 一般不用在人。",
        "zh": "我們需要能準時交貨的供應商。"
      },
      {
        "q": "The machine _____ we bought last year works well.",
        "opts": [
          "who",
          "whose",
          "where",
          "that"
        ],
        "answer": 3,
        "why": "先行詞 machine 是物，關係代名詞在這裡當受詞，可以用 that（或 which，也可省略）。who 是人，whose 是所有格。",
        "zh": "我們去年買的那台機器運作良好。"
      }
    ]
  },
